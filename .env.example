# raemy ai — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.

# --- Anthropic (generation brain) ---
ANTHROPIC_API_KEY=

# --- Supabase (sole system of record) ---
# Project: raemy-ai (ref cpvxkqqujwiwmqrpeomn, org "HC AGENT Stack").
# URL + anon key are public and safe to commit. The app reads SERVER-SIDE with
# the service-role key (RLS is on with no public policies, so the anon key can't
# read anything). Without SUPABASE_SERVICE_ROLE_KEY the app falls back to mock data.
SUPABASE_URL=https://cpvxkqqujwiwmqrpeomn.supabase.co
SUPABASE_ANON_KEY=sb_publishable_OcDLO1aHyo3K-1eIhyNmzQ_jXHAI5ZK
# Get this from: Supabase dashboard -> Project Settings -> API -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Drive (folder ingestion) ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# --- Transcription / ASR (Phase 4) ---
TRANSCRIBE_API_KEY=

# --- Rendering (carousel/static, Phase 3) ---
# Rendering is SELF-HOSTED (Satori -> PNG, lib/render) — no third-party render
# account needed. Rendered PNGs are stored in a PUBLIC Supabase Storage bucket.
# It must exist and be PUBLIC. Defaults to "content-assets" if unset.
CONTENT_ASSETS_BUCKET=content-assets

# --- Clipping tool (reels, Phase 6) ---
CLIPPER_API_KEY=

# --- Multi-platform posting (Phase 6) ---
POSTER_API_KEY=

# --- Cost control ---
# Per-client monthly model-spend cap in USD (hard rule 4). Defaults to 50.
MONTHLY_COST_QUOTA_USD=
