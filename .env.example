# raemy ai — environment variables (Google Cloud)
# On the VM, copy to .env next to docker-compose.yml and fill in. NEVER commit real secrets.

# --- Claude via Vertex AI (GCP billing) ---
# Set the project id and Claude is billed through your Google Cloud invoice and
# authenticates via the VM/Cloud Run service account (Application Default
# Credentials) — no API key. Enable Claude in Vertex Model Garden first.
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=us-central1
# If a model needs a Vertex-specific id, override per-model (verify in Model Garden):
# VERTEX_MODEL_CLAUDE_OPUS_4_8=claude-opus-4-8@xxxxxxxx
# Fallback: set this instead of the Vertex vars to use the direct Anthropic API.
ANTHROPIC_API_KEY=

# --- Cloud SQL / Postgres (sole system of record) ---
# The app reads one connection string. On the single-VM setup, docker-compose
# builds this from the POSTGRES_* values below. For managed Cloud SQL later,
# point DATABASE_URL at the instance and the app code does not change.
DATABASE_URL=
# Used by docker-compose to provision the local Postgres container:
POSTGRES_USER=raemy_app
POSTGRES_PASSWORD=
POSTGRES_DB=raemy

# --- Cloud Storage (rendered assets + DB backups) ---
# Buckets must exist; the assets bucket must be public-readable. The VM service
# account needs objectAdmin on both. See MIGRATION.md.
GCS_ASSETS_BUCKET=raemy-content-assets
BACKUP_BUCKET=raemy-db-backups

# --- Cron auth (Cloud Scheduler / VM cron -> /api/cron/*) ---
# Shared secret sent as `Authorization: Bearer $CRON_SECRET`. Generate a long
# random string (e.g. openssl rand -hex 32).
CRON_SECRET=

# --- Google Drive (folder ingestion) ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# --- Transcription / ASR (Phase 4) ---
TRANSCRIBE_API_KEY=

# --- Canva (carousel/static render, Phase 3) ---
# Connect API access token from the OAuth flow (e.g. via the canva-connect-api
# starter kit). NOTE: access tokens expire after ~4 hours — fine for a test
# render; production needs refresh-token handling (not built yet).
CANVA_CONNECT_TOKEN=
# (Rendered PNGs are rehosted into GCS_ASSETS_BUCKET, configured above.)

# --- Clipping tool (reels, Phase 6) ---
CLIPPER_API_KEY=

# --- Multi-platform posting (Phase 6) ---
POSTER_API_KEY=

# --- Cost control ---
# Per-client monthly model-spend cap in USD (hard rule 4). Defaults to 50.
MONTHLY_COST_QUOTA_USD=
